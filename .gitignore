# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Production env (VITE_ keys baked into the build) — NEVER commit live keys
.env.production
.env.production.local

# Local pointer to the private working-context folder (read by scripts/state.mjs).
# Never commit it: the path is private.
.safesql-internal-path

# Sprint working backups (created during in-progress edits, not for commit)
*.sprint*-baseline

# Local screenshots / dev captures
pictures/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.claude
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# Python build artifacts from the pre-commit shim (pyproject.toml at root)
build/
*.egg-info/
__pycache__/
*.pyc

# Benchmark datasets — Spider (4 MB) and BIRD (2.1 GB extracted). Downloaded by
# the harness; see benchmark/README. Never committed.
benchmark/datasets/

# Benchmark output — generated by run_benchmark.py, not source.
benchmark/results/*.json
