{
  "openapi": "3.1.0",
  "info": {
    "title": "SafeSQL Validation API",
    "version": "0.8.0",
    "description": "Pre-execution semantic SQL validation. Runs the same 35-detector engine as the SafeSQL editor over HTTP — embed it in text-to-SQL pipelines and CI.",
    "contact": { "name": "SafeSQL", "url": "https://safesqlpro.dev" }
  },
  "servers": [{ "url": "https://safesql.pages.dev" }],
  "paths": {
    "/api/validate": {
      "post": {
        "summary": "Validate a SQL query",
        "description": "Returns a structured ValidationReport (errors, warnings, suggestions, risk score). Provide DDL to enable schema-aware detectors.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ValidateRequest" },
              "example": {
                "sql": "SELECT id, lifetime_value FROM users",
                "ddl": "CREATE TABLE users (id UUID PRIMARY KEY, email TEXT)",
                "dialect": "postgresql",
                "source": "cursor"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation report",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationReport" },
                "example": {
                  "riskScore": 25,
                  "executionSafe": false,
                  "errors": [
                    { "id": "HALLUCINATED_COLUMN", "severity": "error", "description": "Column lifetime_value does not exist on users", "fix": "Remove it or add it to the schema." }
                  ],
                  "warnings": [],
                  "suggestions": [],
                  "processingMs": 12,
                  "detectorVersion": "0.5.0"
                }
              }
            }
          },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "sql field is required" } } } },
          "401": { "description": "Missing or invalid API key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Invalid API key. Get yours at safesqlpro.dev/settings" } } } },
          "413": { "description": "Request body exceeds the 25 MB limit (dbt artifacts too large)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Request body exceeds 25 MB limit" } } } },
          "429": { "description": "Rate limit exceeded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Rate limit exceeded. Upgrade at safesqlpro.dev/pricing" } } } },
          "500": { "description": "Server error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "options": { "summary": "CORS preflight", "responses": { "204": { "description": "No content" } } }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "ssk_live_*", "description": "API key from safesqlpro.dev/settings. Header: Authorization: Bearer ssk_live_xxxxx" }
    },
    "schemas": {
      "ValidateRequest": {
        "type": "object",
        "required": ["sql"],
        "properties": {
          "sql": { "type": "string", "description": "The SQL query to validate." },
          "ddl": { "type": "string", "description": "Optional CREATE TABLE DDL to enable schema-aware detectors." },
          "dialect": { "type": "string", "enum": ["postgresql", "mysql", "bigquery", "snowflake"], "default": "postgresql" },
          "source": { "type": "string", "enum": ["cursor", "copilot", "chatgpt", "manual", "unknown"], "description": "Where the SQL came from (analytics tagging)." },
          "include_ai_explanations": { "type": "boolean", "default": false },
          "dbt": {
            "type": "object",
            "description": "Optional dbt artifacts. When present, the schema is derived from catalog.json + manifest.json (PK/FK/nullable from unique / not_null / relationships tests) and the UNAPPROVED_SOURCE and FINANCE_TAG_UNVALIDATED detectors run. `ddl`, if also supplied, wins per table. The total request body is capped at 25 MB (HTTP 413 above that).",
            "required": ["manifest"],
            "properties": {
              "manifest": { "type": "object", "description": "Parsed target/manifest.json (dbt manifest schema v10-v12). Required." },
              "catalog": { "type": "object", "description": "Parsed target/catalog.json from `dbt docs generate`. Optional; supplies complete column lists and warehouse types." },
              "runResults": { "type": "object", "description": "Parsed target/run_results.json. Optional; supplies the last run status per model." },
              "sensitiveTags": { "type": "array", "items": { "type": "string" }, "default": ["finance", "pii"], "description": "Tags that make a relation sensitive for FINANCE_TAG_UNVALIDATED." },
              "currentModel": { "type": "string", "description": "dbt name of the model whose SQL is being validated. Lets a staging model read its own raw source without an UNAPPROVED_SOURCE finding." }
            }
          }
        }
      },
      "Issue": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "issueType, e.g. AGGREGATE_OVER_FANOUT_JOIN" },
          "severity": { "type": "string", "enum": ["error", "warning", "suggestion"] },
          "offendingClause": { "type": "string" },
          "offendingTable": { "type": "string" },
          "offendingColumn": { "type": "string" },
          "description": { "type": "string" },
          "fix": { "type": "string" },
          "scoreImpact": { "type": "number" }
        }
      },
      "ValidationReport": {
        "type": "object",
        "properties": {
          "riskScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "executionSafe": { "type": "boolean" },
          "errors": { "type": "array", "items": { "$ref": "#/components/schemas/Issue" } },
          "warnings": { "type": "array", "items": { "$ref": "#/components/schemas/Issue" } },
          "suggestions": { "type": "array", "items": { "$ref": "#/components/schemas/Issue" } },
          "processingMs": { "type": "number" },
          "detectorVersion": { "type": "string" },
          "dbtContext": {
            "type": "object",
            "description": "Present only when `dbt` was supplied. Provenance of the loaded context, never the artifacts themselves.",
            "properties": {
              "models": { "type": "integer" },
              "sources": { "type": "integer" },
              "sensitiveTagged": { "type": "integer", "description": "Relations carrying any configured sensitive tag." },
              "artifacts": { "type": "object", "properties": { "catalog": { "type": "boolean" }, "runResults": { "type": "boolean" } } },
              "warnings": { "type": "array", "items": { "type": "string" }, "description": "Non-fatal artifact problems (unknown schema version, orphan catalog node)." }
            }
          }
        }
      },
      "Error": { "type": "object", "properties": { "error": { "type": "string" } } }
    }
  }
}
